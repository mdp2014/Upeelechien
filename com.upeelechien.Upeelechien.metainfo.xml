<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">

  <id>com.github.mdp2014.Upeelechien</id>

  <name>Upeelechien</name>
  <name xml:lang="fr">Upeelechien</name>

  <summary>IA française locale pour Linux</summary>
  <summary xml:lang="fr">IA française locale pour Linux</summary>

  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>

  <developer id="com.github.mdp2014">
    <name>Marin</name>
  </developer>

  <description>
    <p>
      Upeelechien est une intelligence artificielle française locale
      développée par Marin pour Linux.
    </p>
    <p>
      Upeelechien utilise Qwen3 1.7B avec Ollama afin de permettre
      l'utilisation d'une IA directement sur votre ordinateur.
    </p>
    <p>
      L'application fonctionne localement et ne nécessite pas de compte.
      Ollama et le modèle nécessaire sont installés automatiquement.
    </p>
    <p>
      Upeelechien propose une interface simple et légère pour discuter
      avec une intelligence artificielle directement depuis le bureau.
    </p>
  </description>

  <launchable type="desktop-id">upeelechien.desktop</launchable>

  <provides>
    <binary>upeelechien</binary>
  </provides>

  <categories>
    <category>Utility</category>
  </categories>

  <keywords>
    <keyword>IA</keyword>
    <keyword>AI</keyword>
    <keyword>Assistant</keyword>
    <keyword>Chat</keyword>
    <keyword>Qwen</keyword>
    <keyword>Ollama</keyword>
  </keywords>

  <content_rating type="oars-1.1"/>

