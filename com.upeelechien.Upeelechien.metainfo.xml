<component type="desktop-application">

  <id>com.upeelechien.Upeelechien</id>

  <name>Upeelechien</name>
  <name xml:lang="fr">Upeelechien</name>

  <summary>IA française locale pour Linux</summary>
  <summary xml:lang="fr">IA française locale pour Linux</summary>

  <metadata_license>CC0-1.0</metadata_license>

  <description>
    <p>
      Upeelechien est une intelligence artificielle française locale
      développée par Marin pour Linux.
    </p>

    <p>
      Upeelechien utilise Qwen3 1.7B avec Ollama pour faire fonctionner
      une intelligence artificielle directement sur votre ordinateur,
      sans compte en ligne.
    </p>

    <p>
      L'application propose une interface simple depuis le terminal
      et fonctionne localement sur votre machine.
    </p>

    <p>
      Lors de la première utilisation, les composants nécessaires sont
      installés automatiquement.
    </p>
  </description>

  <launchable type="desktop-id">upeelechien.desktop</launchable>

  <provides>
    <binary>upeelechien</binary>
  </provides>

